# Ejemplo de variables de entorno — prisma_backend (POS).

# --- Base de datos ---
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/prisma"
PORT=5012

# --- Licenciamiento (servicio en la nube) ---
# LICENSING_SERVER_URL vacío = modo offline (solo valida license.key local).
# En producción (NODE_ENV=production), si queda vacío se usa
# https://licencias-api.prismapos.site por defecto.
LICENSING_SERVER_URL=https://licencias-api.prismapos.site
# Cliente (agrupa la activación en el panel).
LICENSING_CLIENT_CODE=CLIENTE
# Contexto (tienda/POS).
STORE_NAME=Tienda
STORE_ID=001
POS_NO=1
# Sondeo de aprobación del enrolamiento (ms).
LICENSING_POLL_MS=10000
# 0 = esperar aprobación indefinidamente.
LICENSING_ENROLL_MAX_ATTEMPTS=0
# Directorio de archivos de licencia (por defecto el cwd). Solo para pruebas.
# LICENSING_DIR=
